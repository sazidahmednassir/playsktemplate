{
  "name": "playwrg",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "pretest": "rm -f excel/results/*.xlsx",
    "test": "npx playwright test",
    "test:parallel": "PARALLEL=true npx playwright test",
    "test:serial": "npx playwright test",
    "smoke": "npx playwright test --grep @smoke",
    "regression": "npx playwright test --grep @regression",
    "gen:excel": "node scripts/generate-excel.js",
    "gen:report": "node scripts/generate-report.js",
    "qa:report": "npx playwright test --reporter=json > evidence/results.json; node scripts/generate-report.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@cucumber/cucumber": "^11.1.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.9.3",
    "allure-playwright": "^3.0.7"
  },
  "dependencies": {
    "docx": "^9.0.0",
    "dotenv": "^16.6.1",
    "playwright": "^1.49.1",
    "xlsx": "^0.18.5"
  }
}
